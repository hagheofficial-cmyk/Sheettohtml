  if (path.indexOf('/api/reminders') === 0) return (db.reminders || []).find((x) => String(x.id) === key) || null;
  if (path.indexOf('/api/actions') === 0) {
    const map = db.agentActions || {};
    for (const name of Object.keys(map)) {
